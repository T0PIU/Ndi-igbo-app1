PORT=3000
# Leave DATABASE_URL empty to use a SQLite file. Set it for PostgreSQL (recommended for production).
DATABASE_URL=
DATABASE_SSL=off            # off | on | no-verify (many hosts need "on")
SQLITE_PATH=./data/ndi.db
TRUST_PROXY=1               # 1 when behind Render/Railway/nginx
COOKIE_SECURE=true          # true on https
SIGNUPS_OPEN=true
SIGNUP_LIMIT_PER_HOUR=60
# Optional
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAP_ID=
ANTHROPIC_API_KEY=
